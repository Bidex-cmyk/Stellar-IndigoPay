{
  "manifest_version": 3,
  "name": "IndigoPay Companion",
  "version": "1.0.0",
  "description": "Support your favorite sustainable projects with a single click.",
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "IndigoPay Companion"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "background": {
    "scripts": [
      "dist-firefox/background.js"
    ]
  },
  "host_permissions": [
    "https://api.stellar-indigopay.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dist-firefox/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "privacy_policy_url": "https://github.com/Stellar-IndigoPay/Stellar-IndigoPay/blob/main/PRIVACY.md",
  "browser_specific_settings": {
    "gecko": {
      "id": "indigopay@stellar-indigopay.com",
      "strict_min_version": "120.0"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "commands": {
    "preset-1": {
      "suggested_key": {
        "default": "Ctrl+1",
        "mac": "MacCtrl+1"
      },
      "description": "Select Preset 1"
    },
    "preset-2": {
      "suggested_key": {
        "default": "Ctrl+2",
        "mac": "MacCtrl+2"
      },
      "description": "Select Preset 2"
    },
    "preset-3": {
      "suggested_key": {
        "default": "Ctrl+3",
        "mac": "MacCtrl+3"
      },
      "description": "Select Preset 3"
    },
    "preset-4": {
      "suggested_key": {
        "default": "Ctrl+4",
        "mac": "MacCtrl+4"
      },
      "description": "Select Preset 4"
    }
  }
}